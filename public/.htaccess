# Cache policy for the built site (copied to dist/ by Vite; read by Hostinger's LiteSpeed/Apache).
#
#  - Vite output in /assets/ has a content hash in the file name (name-AbCd1234.js),
#    so a new deploy always gets new URLs: cache for a year, never revalidate.
#  - index.html must always be revalidated, or visitors keep pointing at old bundles.
#  - Everything else (public/ images and sounds, favicon) keeps its name between
#    deploys, so it gets a shorter cache that can still pick up replaced files.

<IfModule mod_headers.c>
  # HTML: always revalidate (cheap 304 when unchanged)
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Unhashed static files from public/
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|mp3|wav|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Hashed build output: name-<8 char hash>.ext (must stay after the rule above)
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|avif|png|jpe?g|svg|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback when mod_headers is unavailable
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/javascript .js
</IfModule>

# Text compression (LiteSpeed usually does this already; harmless if so)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
